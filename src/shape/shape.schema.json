{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^R[1-9][0-9]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              }
            },
            "required": [
              "given",
              "when",
              "then"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "text",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minProperties": 1
    },
    "non_goals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^N[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "boundary",
              "deferral"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "type",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "approach": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "touchpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^D[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "rejected": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "string"
          },
          "decided_by": {
            "type": "string",
            "enum": [
              "user",
              "silence"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "one_way_door",
              "two_way_door"
            ]
          }
        },
        "required": [
          "decision",
          "rejected",
          "provenance",
          "decided_by",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outcome",
    "requirements",
    "non_goals",
    "approach",
    "constraints",
    "touchpoints",
    "decisions"
  ],
  "additionalProperties": false
}
