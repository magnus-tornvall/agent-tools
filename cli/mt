#!/usr/bin/env bun
// mt: load the know-how of the owner's tools on demand, record every load, check shapes, and file
// dogfooding findings. get, list and dogfood need nothing beyond this file and, for dogfood, gh;
// shape loads src/shape/ only when it is called.

import { appendFileSync, existsSync, mkdirSync, readdirSync, readFileSync, realpathSync, statSync } from "node:fs";
import { basename, dirname, join } from "node:path";

const USAGE = `usage: mt get <tool> [--ref <ref>]   print the guide for a tool, or one of its references
       mt list                       list every tool with when to use it
       mt shape check <file>         check that a file is a shape
       mt shape slice <file> --keys <key,...>
                                     print only those top-level keys of a shape
       mt dogfood <title> [--body-file <file>]
                                     file a finding as an issue labelled dogfooding on
                                     this repo's GitHub, through gh; - reads the body from stdin
       mt --help                     show this usage

Every \`get\` is appended to $MT_LOG, or \${XDG_STATE_HOME:-$HOME/.local/state}/mt/usage.jsonl.
`;

const ROOT = dirname(dirname(realpathSync(import.meta.path)));

class UsageError extends Error {}

function isFile(path: string): boolean {
  return existsSync(path) && statSync(path).isFile();
}

function nonEmpty(value: string | undefined): string | null {
  return value ? value : null;
}

function headCommit(): string | null {
  if (Bun.which("git") === null) return null;
  const result = Bun.spawnSync(["git", "-C", ROOT, "rev-parse", "HEAD"], { stderr: "ignore" });
  return result.success ? nonEmpty(result.stdout.toString().trim()) : null;
}

function logGet(tool: string, ref: string, found: boolean): void {
  const env = process.env;
  const log = env.MT_LOG || join(env.XDG_STATE_HOME || join(env.HOME ?? "", ".local/state"), "mt/usage.jsonl");
  const entry = {
    time: new Date().toISOString().replace(/\.\d{3}Z$/, "Z"),
    tool,
    ref: nonEmpty(ref),
    found,
    commit: headCommit(),
    session: nonEmpty(env.CLAUDE_CODE_SESSION_ID),
    terminal: nonEmpty(env.ORCA_TERMINAL_HANDLE),
    worktree: nonEmpty(env.ORCA_WORKTREE_ID),
  };
  try {
    mkdirSync(dirname(log), { recursive: true });
    appendFileSync(log, `${JSON.stringify(entry)}\n`);
  } catch {
    process.stderr.write(`mt: could not write usage log ${log}\n`);
  }
}

function validName(name: string): boolean {
  return /^[A-Za-z0-9_-][A-Za-z0-9._-]*$/.test(name);
}

function cmdGet(args: string[]): number {
  let tool = "";
  let ref = "";
  let haveRef = false;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i] ?? "";
    if (arg === "--ref") {
      if (i + 1 >= args.length) throw new UsageError("--ref needs a value");
      ref = args[++i] ?? "";
      haveRef = true;
    } else if (arg.startsWith("-")) {
      throw new UsageError(`unknown option '${arg}'`);
    } else {
      if (tool !== "") throw new UsageError(`unexpected argument '${arg}'`);
      tool = arg;
    }
  }
  if (tool === "") throw new UsageError("get needs a tool");

  let file = "";
  if (validName(tool)) {
    if (!haveRef) file = join(ROOT, "guides", `${tool}.md`);
    else if (validName(ref)) file = join(ROOT, "guides", tool, `${ref}.md`);
  }

  if (file !== "" && isFile(file)) {
    logGet(tool, ref, true);
    process.stdout.write(readFileSync(file));
    return 0;
  }

  logGet(tool, ref, false);
  if (haveRef) process.stderr.write(`mt: no reference '${ref}' for tool '${tool}'. Run 'mt list' to see the tools.\n`);
  else process.stderr.write(`mt: no guide for tool '${tool}'. Run 'mt list' to see the tools.\n`);
  return 1;
}

const SPACE = "[ \\t\\n\\v\\f\\r]";
const LEADING_SPACE = new RegExp(`^${SPACE}+`);
const TRAILING_SPACE = new RegExp(`${SPACE}+$`);

/** The `description` in a stub's front matter, a folded or literal block joined with spaces. */
function stubDescription(file: string): string {
  const lines = readFileSync(file, "utf8").split("\n");
  if (lines[0]?.replace(/\r$/, "") !== "---") return "";
  let inDescription = false;
  let description = "";
  for (const raw of lines.slice(1)) {
    const line = raw.replace(/\r$/, "");
    if (line === "---") break;
    if (inDescription) {
      if (line.startsWith(" ") || line.startsWith("\t")) {
        const part = line.replace(LEADING_SPACE, "");
        description = description === "" ? part : `${description} ${part}`;
        continue;
      }
      if (line === "") continue;
      break;
    }
    if (!line.startsWith("description:")) continue;
    const part = line.slice("description:".length).replace(LEADING_SPACE, "").replace(TRAILING_SPACE, "");
    if (part.startsWith(">") || part.startsWith("|")) {
      inDescription = true;
      continue;
    }
    const quote = part[0];
    if (part.length >= 2 && (quote === '"' || quote === "'") && part.endsWith(quote)) return part.slice(1, -1);
    return part;
  }
  return description;
}

function cmdList(): number {
  const guides = join(ROOT, "guides");
  const names = existsSync(guides) ? readdirSync(guides).filter((name) => name.endsWith(".md")).sort() : [];
  for (const name of names) {
    if (!isFile(join(guides, name))) continue;
    const tool = basename(name, ".md");
    const stub = join(ROOT, "skills", tool, "SKILL.md");
    if (!isFile(stub)) continue;
    process.stdout.write(`${tool.padEnd(20)} ${stubDescription(stub)}\n`);
  }
  return 0;
}

function orcaVersion(): string | null {
  if (Bun.which("orca") === null) return null;
  const result = Bun.spawnSync(["orca", "--version"], { stderr: "ignore" });
  return result.success ? nonEmpty(result.stdout.toString().trim()) : null;
}

/** What the finding was seen on, appended to its body so the issue says it without the agent writing it. */
function seenOn(): string {
  const env = process.env;
  const facts: [string, string | null][] = [
    ["mt commit", headCommit()],
    ["orca", orcaVersion()],
    ["session", nonEmpty(env.CLAUDE_CODE_SESSION_ID)],
    ["terminal", nonEmpty(env.ORCA_TERMINAL_HANDLE)],
    ["worktree", nonEmpty(env.ORCA_WORKTREE_ID)],
  ];
  const lines = facts.filter(([, value]) => value !== null).map(([key, value]) => `- ${key}: \`${value}\``);
  return `---\nFiled with \`mt dogfood\`.\n${lines.join("\n")}\n`;
}

function cmdDogfood(args: string[]): number {
  let title = "";
  let bodyFile = "";
  for (let i = 0; i < args.length; i++) {
    const arg = args[i] ?? "";
    if (arg === "--body-file") {
      if (i + 1 >= args.length) throw new UsageError("--body-file needs a value");
      bodyFile = args[++i] ?? "";
    } else if (arg.startsWith("-")) {
      throw new UsageError(`unknown option '${arg}'`);
    } else {
      if (title !== "") throw new UsageError(`unexpected argument '${arg}'`);
      title = arg;
    }
  }
  if (title.trim() === "") throw new UsageError("dogfood needs a title");

  let body = "";
  if (bodyFile !== "") {
    try {
      body = readFileSync(bodyFile === "-" ? 0 : bodyFile, "utf8").trim();
    } catch (error) {
      const reason = error instanceof Error ? error.message : String(error);
      process.stderr.write(`mt: cannot read '${bodyFile}': ${reason}\n`);
      return 1;
    }
  }

  if (Bun.which("gh") === null) {
    process.stderr.write("mt: finding not filed: gh is not on PATH\n");
    return 0;
  }
  const result = Bun.spawnSync(
    ["gh", "issue", "create", "--title", title, "--label", "dogfooding", "--body-file", "-"],
    {
      cwd: ROOT,
      stdin: Buffer.from(body === "" ? seenOn() : `${body}\n\n${seenOn()}`),
      env: { ...process.env, GH_PROMPT_DISABLED: "1" },
    },
  );
  if (!result.success) {
    const reason = result.stderr.toString().split("\n").find((line) => line.trim() !== "") ?? "gh failed";
    process.stderr.write(`mt: finding not filed: ${reason.trim()}\n`);
    return 0;
  }
  process.stdout.write(result.stdout);
  return 0;
}

async function cmdShape(args: string[]): Promise<number> {
  const { runShape }: typeof import("../src/shape/command.ts") = await import(join(ROOT, "src/shape/command.ts"));
  return runShape(args);
}

async function main(args: string[]): Promise<number> {
  const [command = "", ...rest] = args;
  switch (command) {
    case "get":
      return cmdGet(rest);
    case "list":
      return cmdList();
    case "shape":
      return cmdShape(rest);
    case "dogfood":
      return cmdDogfood(rest);
    case "":
    case "-h":
    case "--help":
    case "help":
      process.stdout.write(USAGE);
      return 0;
    default:
      throw new UsageError(`unknown command '${command}'`);
  }
}

try {
  process.exitCode = await main(process.argv.slice(2));
} catch (error) {
  if (!(error instanceof UsageError)) throw error;
  process.stderr.write(`mt: ${error.message}\n${USAGE}`);
  process.exitCode = 2;
}
