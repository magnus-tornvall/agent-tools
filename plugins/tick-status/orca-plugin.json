{
  "manifestVersion": 1,
  "id": "tick-status",
  "publisher": "agent-tools",
  "name": "Tick status",
  "version": "0.1.0",
  "description": "Prototype: three routes for showing `tick status` for one Run inside Orca.",
  "engines": { "orca": ">=1.4.222" },
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "contributes": {
    "commands": [{ "id": "tick-status.show", "title": "Tick status: show counts for the Run", "context": "global" }],
    "panels": [{ "id": "tick-status", "title": "Tick status", "icon": "activity", "entry": "panel.html" }]
  },
  "capabilities": [{ "kind": "notifications:show" }, { "kind": "terminal:send" }, { "kind": "workspace:read" }]
}
